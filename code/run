#!/usr/bin/env bash
# Code Ocean reproducible-run entry point (cwd = /code).
#
# Default: verify anonymized result tables and copy them to ../results.
# Optional: RUN_NOTEBOOKS=1 also executes notebooks 02/03/05 from shipped
# CLIP / DINOv3 category embeddings.
#
# Env knobs:
#   CATEGORY_SET=valid129|valid85   (default valid129)
#   RUN_NOTEBOOKS=1                 also nbconvert notebooks 02/03/05
#   PIP_INSTALL=0                   skip pip install of requirements
set -euo pipefail

CODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANUSCRIPT_DIR="${CODE_DIR}/manuscript-2026"
# Resolve to canonical paths (avoid /../ in find results; BSD find's
# -path '*/.*' would otherwise match '/../' and empty the index).
CAPSULE_ROOT="$(cd "${CODE_DIR}/.." && pwd)"
RESULTS_DIR="${CAPSULE_ROOT}/results"
DATA_DIR="${CAPSULE_ROOT}/data"

mkdir -p "${RESULTS_DIR}"

# Writable caches for headless Matplotlib/fontconfig. Keep these out of
# /results so they do not appear in the Code Ocean computation snapshot.
export MPLCONFIGDIR="${TMPDIR:-/tmp}/babyview_mplconfig"
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/babyview_cache"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}"

echo "=============================================="
echo "BabyView Objects — Code Ocean reproducible run"
echo "=============================================="
echo "code:      ${CODE_DIR}"
echo "data:      ${DATA_DIR}"
echo "results:   ${RESULTS_DIR}"
echo "manuscript:${MANUSCRIPT_DIR}"
echo

if [[ "${PIP_INSTALL:-1}" != "0" ]]; then
  echo "[1/4] Installing Python requirements..."
  python -m pip install --quiet -r "${MANUSCRIPT_DIR}/requirements-manuscript.txt"
else
  echo "[1/4] Skipping pip install (PIP_INSTALL=0)"
fi

echo "[2/4] Verifying shared anonymized tables (MANIFEST.json)..."
python "${MANUSCRIPT_DIR}/scripts/verify_shared_data.py" --strict

echo "[3/4] Publishing shared tables to results/..."
EXTRA_ARGS=()
if [[ "${RUN_NOTEBOOKS:-0}" == "1" ]]; then
  EXTRA_ARGS+=(--run-notebooks)
fi

CATEGORY_SET="${CATEGORY_SET:-valid129}" \
  python "${MANUSCRIPT_DIR}/scripts/reproduce_capsule.py" \
    --category-set "${CATEGORY_SET:-valid129}" \
    ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}

echo "[4/4] Writing results index..."
{
  echo "BabyView Objects capsule results"
  echo "Generated by: code/run"
  echo "CATEGORY_SET=${CATEGORY_SET:-valid129}"
  echo "Models: CLIP, DINOv3"
  echo
  echo "Contents:"
  find "${RESULTS_DIR}" -type f -not -path '*/.*' | sort | sed "s|^${RESULTS_DIR}/||"
} > "${RESULTS_DIR}/INDEX.txt"

echo
echo "Reproducible run finished successfully."
echo "See ${RESULTS_DIR}/INDEX.txt"
